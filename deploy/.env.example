# Template for deploy/.env, the settings of ONE server (HP7).
# Copy it to deploy/.env and fill in this server's values; Docker Compose reads
# deploy/.env automatically. deploy/.env is git-ignored because every server differs.
# Find the values with `hostname` (name) and `hostname -I` (IP addresses).
# With localhost, the site opens only on the server machine itself.

# SPECWEB_HOST: every name and IP that users type in the browser, comma-separated,
# e.g. "wks0019, 192.168.4.161". Caddy answers only these and makes an HTTPS
# certificate for each (see Caddyfile).
SPECWEB_HOST=localhost

# SPECWEB_DEFAULT_SNI: the IP from SPECWEB_HOST, if it lists one. Browsers opening
# https://<IP> name no site, so Caddy shows this one's certificate to them
# (Caddyfile: default_sni).
SPECWEB_DEFAULT_SNI=localhost
